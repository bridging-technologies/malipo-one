{
    "name": "malipo-one/php-sdk",
    "description": "Official PHP SDK for the Malipo One payments API — mobile money collection, payment links, refunds and balances for Tanzania.",
    "type": "library",
    "keywords": ["malipo", "payments", "mpesa", "tigopesa", "airtel", "tanzania", "mobile-money", "sdk"],
    "homepage": "https://malipo.one",
    "license": "MIT",
    "authors": [
        {
            "name": "Malipo One",
            "email": "dev@malipo.one",
            "homepage": "https://malipo.one"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "guzzlehttp/psr7": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MalipoOne\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MalipoOne\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
